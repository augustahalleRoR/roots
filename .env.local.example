# Copy this file to .env.local and fill in the values from
# https://sanity.io/manage after running `npx sanity login`.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Server-only. Create at sanity.io/manage -> API -> Tokens, "Editor" permission.
# Never expose this to the browser (no NEXT_PUBLIC_ prefix).
SANITY_API_TOKEN=

# The public URL once the domain is live (no trailing slash), e.g.
# https://rootsontheroad.org. Used for the sitemap and share previews.
# On Vercel it falls back to the project's production URL if unset.
NEXT_PUBLIC_SITE_URL=
